rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasTeamClaim(teamId) {
      return signedIn() && request.auth.token.teamId == teamId;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    // Verifica a role diretamente no documento /users/{uid} do Firestore
    // Usada durante o onboarding, antes das custom claims estarem presentes no token
    function hasRoleInDoc(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isTrainer(teamId) {
      return (hasTeamClaim(teamId) && hasRole('trainer'))
        || (signedIn() && request.auth.uid == teamId && hasRoleInDoc('trainer'));
    }

    function isAssistant(teamId) {
      return hasTeamClaim(teamId) && hasRole('assistant');
    }

    function isStudent(teamId) {
      return (hasTeamClaim(teamId) && hasRole('student'))
        || (signedIn() && hasRoleInDoc('student'));
    }

    function teamDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId));
    }

    function studentDoc(teamId, studentId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/students/$(studentId));
    }

    function cancelWindowHours(teamId) {
      return teamDoc(teamId).data.settings.cancelWindowHours == null
        ? 2
        : teamDoc(teamId).data.settings.cancelWindowHours;
    }

    function studentIsActive(teamId, studentId) {
      return studentDoc(teamId, studentId).data.status == 'active';
    }

    function ownsStudentDoc(teamId, studentId) {
      return hasTeamClaim(teamId) && request.auth.uid == studentId;
    }

    function assistantAssignedToExisting(teamId, studentId) {
      return isAssistant(teamId) && studentDoc(teamId, studentId).data.assignedTo == request.auth.uid;
    }

    function assistantAssignedToIncoming() {
      return request.resource.data.assignedTo == request.auth.uid;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function publicTeamFieldsOnly() {
      return request.resource.data.keys().hasOnly([
        'name',
        'slug',
        'ownerUid',
        'isSolo',
        'id',
        'branding',
        'settings',
        'trainingModalities',
        'publicListing',
        'publicProfile',
        'city',
        'contactPhone',
        'worksAt',
        'acceptsHomeVisit',
        'acceptsCondoGym',
        'availability',
        'createdAt'
      ]);
    }

    // ─── Coleção raiz: users ─────────────────────────────────────────────
    // Cada utilizador pode ler e escrever o seu próprio documento.
    // Durante o onboarding o setDoc define role/teamId pela primeira vez,
    // por isso o create é livre (para o próprio uid).
    // O update protege apenas contra troca de role/teamId por um usuário
    // que já tem esses campos — exceto se o documento ainda não os tiver
    // (onboarding incompleto).
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || request.auth.token.teamId == resource.data.teamId);

      // Create: usuário autenticado criando o seu próprio documento
      allow create: if signedIn() && request.auth.uid == uid;

      // Update: o próprio usuário pode atualizar.
      // Se role e teamId já estiverem definidos, não pode alterá-los.
      // Se ainda não existirem (primeiro onboarding após Google login),
      // permite escrever qualquer campo.
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          // Documento ainda não tinha role → onboarding, pode tudo
          !('role' in resource.data)
          // Já tinha role → só permite mudar campos que não sejam role/teamId
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teamId'])
        );

      allow delete: if false;
    }

    // ─── Coleção raiz: students ──────────────────────────────────────────
    // Alunos criam o próprio documento durante o onboarding.
    match /students/{studentId} {
      allow read: if signedIn()
        && (request.auth.uid == studentId
            || hasRoleInDoc('trainer'));

      // Create: o próprio usuário autenticado cria seu perfil de aluno
      allow create: if signedIn() && request.auth.uid == studentId;

      // Update: o próprio aluno pode atualizar dados pessoais
      allow update: if signedIn()
        && request.auth.uid == studentId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'assignedTo', 'planId'
        ]);

      allow delete: if false;

      // Medidas confirmadas (gráfico/histórico): aluno dono e treinadores.
      match /measurements/{measureId} {
        allow read: if signedIn() && (request.auth.uid == studentId || hasRoleInDoc('trainer'));
        allow create: if signedIn() && (request.auth.uid == studentId || hasRoleInDoc('trainer'));
        allow update, delete: if signedIn() && hasRoleInDoc('trainer');
      }

      // Medidas pendentes de confirmação (lançadas pelo treinador ou pelo aluno).
      match /measurementSubmissions/{submissionId} {
        allow read: if signedIn() && (request.auth.uid == studentId || hasRoleInDoc('trainer'));
        allow create: if signedIn() && (request.auth.uid == studentId || hasRoleInDoc('trainer'));
        allow update: if signedIn() && (request.auth.uid == studentId || hasRoleInDoc('trainer'));
        allow delete: if false;
      }
    }

    // ─── Coleção raiz: enrollments (vínculos aluno↔treinador) ────────────
    // Um aluno pode ter vários treinadores. Cada documento liga um aluno a
    // um treinador, com status e saldo de aulas próprios.
    match /enrollments/{enrollmentId} {
      // Leem o aluno dono e o treinador do vínculo.
      // O id é `${studentId}__${trainerId}`; o aluno dono é reconhecido pelo
      // próprio id, o que permite checar a existência (get) antes de criar,
      // mesmo quando o documento ainda não existe (resource == null).
      allow read: if signedIn()
        && (enrollmentId.matches(request.auth.uid + '__.*')
            || request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.trainerId);

      // O próprio aluno solicita o vínculo: entra como 'pending' e sem saldo.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.status == 'pending'
        && request.resource.data.classesQuota == 0
        && request.resource.data.classesUsed == 0;

      // Atualização:
      //  - o treinador dono do vínculo pode tudo (aprovar, ajustar saldo);
      //  - o aluno só pode pausar ou cancelar o próprio vínculo (status),
      //    nunca aprovar nem mexer no saldo.
      allow update: if signedIn()
        && (
          request.auth.uid == resource.data.trainerId
          || (
            request.auth.uid == resource.data.studentId
            && onlyChanged(['status'])
            && request.resource.data.status in ['pending', 'paused', 'cancelled', 'active']
            // o aluno nunca pode aprovar a si mesmo (pending → active)
            && !(resource.data.status == 'pending' && request.resource.data.status == 'active')
          )
        );

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.studentId ||
          request.auth.uid == get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.trainerId
        );
        allow create: if signedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.studentId ||
          request.auth.uid == get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.trainerId
        ) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ─── Coleção raiz: teamMembers (sub-treinadores de um time) ─────────
    match /teamMembers/{memberId} {
      // Dono e sub-treinador podem ler o próprio vínculo
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.subTrainerId == request.auth.uid
      );
      // Dono cria convite OU Sub-treinador solicita entrada
      allow create: if signedIn() && (hasRole('trainer') || hasRoleInDoc('trainer')) && (
        request.resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.subTrainerId == request.auth.uid && request.resource.data.status == 'requesting_join')
      );
      // Dono pode gerenciar; sub pode aceitar/recusar (atualizar status e acceptedAt)
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerUid
        || (
          request.auth.uid == resource.data.subTrainerId
          && onlyChanged(['status', 'acceptedAt'])
        )
      );
      allow delete: if false;
    }

    match /trainerChats/{chatId} {
      allow read: if signedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.targetId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid && (hasRole('trainer') || hasRoleInDoc('trainer'));
      allow update: if signedIn() && (
        request.auth.uid == resource.data.requesterId ||
        request.auth.uid == resource.data.targetId
      );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/trainerChats/$(chatId)).data.requesterId == request.auth.uid ||
          get(/databases/$(database)/documents/trainerChats/$(chatId)).data.targetId == request.auth.uid
        );
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && onlyChanged(['read']);
        allow delete: if false;
      }
    }

    // ─── Coleção raiz: workoutSessions (aulas agendadas) ─────────────────
    match /workoutSessions/{id} {
      // Treinador dono, aluno ou sub-treinador atribuído podem ler
      allow read: if signedIn()
        && (request.auth.uid == resource.data.trainerId
            || request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.assignedToId);
      // Somente o treinador dono cria (ele define trainerId = seu UID)
      allow create: if signedIn() && request.auth.uid == request.resource.data.trainerId;
      // Treinador dono ou sub-treinador atribuído podem atualizar (iniciar/finalizar)
      allow update: if signedIn() && (
        request.auth.uid == resource.data.trainerId
        || request.auth.uid == resource.data.assignedToId
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.trainerId;
    }

    // ─── Coleção raiz: classProducts (ofertas/pacotes) ───────────────────
    match /classProducts/{id} {
      // Ofertas ativas são públicas (vitrine); o dono enxerga as suas.
      allow read: if resource.data.active == true
        || (signedIn() && request.auth.uid == resource.data.trainerId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.trainerId;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.trainerId;
    }

    // ─── Coleção raiz: classPurchases (compras de aulas) ─────────────────
    match /classPurchases/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.studentId
            || request.auth.uid == resource.data.trainerId
            || request.auth.uid == resource.data.teamId);
      // O aluno cria o pedido de compra para si.
      allow create: if signedIn() && request.auth.uid == request.resource.data.studentId;
      // O treinador revisa (confirma/recusa) as compras do seu time.
      allow update: if signedIn()
        && (request.auth.uid == resource.data.trainerId
            || request.auth.uid == resource.data.teamId);
      allow delete: if false;
    }

    // ─── Coleção raiz: teams ─────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if resource.data.publicListing == true || hasTeamClaim(teamId) || isTrainer(teamId);

      // Create: treinador cria o próprio ambiente no onboarding.
      // Aceita tanto custom claims (se já presentes) quanto doc Firestore.
      allow create: if signedIn()
        && request.auth.uid == teamId
        && request.resource.data.ownerUid == request.auth.uid
        && (hasRole('trainer') || hasRoleInDoc('trainer'));

      allow update: if isTrainer(teamId) && publicTeamFieldsOnly();
      allow delete: if false;

      match /members/{uid} {
        allow read: if isTrainer(teamId)
          || (hasTeamClaim(teamId) && request.auth.uid == uid);
        allow create, update: if isTrainer(teamId);
        allow delete: if false;
      }

      match /students/{studentId} {
        allow read: if isTrainer(teamId)
          || ownsStudentDoc(teamId, studentId)
          || assistantAssignedToExisting(teamId, studentId);
        allow create: if isTrainer(teamId)
          || (
            isStudent(teamId)
            && ownsStudentDoc(teamId, studentId)
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == request.auth.uid
          );
        allow update: if isTrainer(teamId)
          || (
            ownsStudentDoc(teamId, studentId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'status',
              'assignedTo',
              'planId',
              'classesQuotaMonth',
              'classesUsedMonth',
              'planStartsAt',
              'planEndsAt'
            ])
          )
          || (
            assistantAssignedToExisting(teamId, studentId)
            && assistantAssignedToIncoming()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'status',
              'planId',
              'classesQuotaMonth',
              'classesUsedMonth',
              'planStartsAt',
              'planEndsAt'
            ])
          );
        allow delete: if false;

        match /measurements/{measureId} {
          allow read: if isTrainer(teamId)
            || ownsStudentDoc(teamId, studentId)
            || assistantAssignedToExisting(teamId, studentId);
          allow create: if isTrainer(teamId)
            || ownsStudentDoc(teamId, studentId)
            || assistantAssignedToExisting(teamId, studentId);
          allow update, delete: if isTrainer(teamId);
        }

        match /goals/{goalId} {
          allow read: if isTrainer(teamId)
            || ownsStudentDoc(teamId, studentId)
            || assistantAssignedToExisting(teamId, studentId);
          allow create, update: if isTrainer(teamId)
            || ownsStudentDoc(teamId, studentId)
            || assistantAssignedToExisting(teamId, studentId);
          allow delete: if isTrainer(teamId);
        }
      }

      match /slots/{slotId} {
        allow read: if isTrainer(teamId)
          || isAssistant(teamId)
          || (isStudent(teamId) && studentIsActive(teamId, request.auth.uid));
        allow create, update, delete: if isTrainer(teamId) || isAssistant(teamId);
      }

      match /availability/{availabilityId} {
        allow read: if isTrainer(teamId)
          || isAssistant(teamId)
          || (isStudent(teamId) && studentIsActive(teamId, request.auth.uid));
        allow write: if false;
      }

      match /bookings/{bookingId} {
        allow read: if isTrainer(teamId)
          || (isAssistant(teamId) && resource.data.trainerId == request.auth.uid)
          || (isStudent(teamId) && resource.data.studentId == request.auth.uid);
        allow create: if isTrainer(teamId)
          || (
            isAssistant(teamId)
            && request.resource.data.trainerId == request.auth.uid
          )
          || (
            isStudent(teamId)
            && request.resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'scheduled'
            && studentIsActive(teamId, request.auth.uid)
          );
        allow update: if isTrainer(teamId)
          || (
            isAssistant(teamId)
            && resource.data.trainerId == request.auth.uid
          )
          || (
            isStudent(teamId)
            && resource.data.studentId == request.auth.uid
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.trainerId == resource.data.trainerId
            && request.resource.data.startsAt == resource.data.startsAt
            && (
              (
                request.resource.data.status == 'cancelled'
                && resource.data.status == 'scheduled'
                && onlyChanged(['status', 'cancelledAt'])
                && resource.data.startsAt > request.time + duration.value(cancelWindowHours(teamId), 'h')
              )
              || (
                request.resource.data.status == 'no_show'
                && resource.data.status == 'scheduled'
                && onlyChanged(['status', 'noShowJustification'])
              )
            )
          );
        allow delete: if false;
      }

      match /plans/{planId} {
        allow read: if resource.data.active == true || isTrainer(teamId);
        allow write: if isTrainer(teamId);
      }

      match /subscriptions/{studentId} {
        allow read: if isTrainer(teamId) || ownsStudentDoc(teamId, studentId);
        allow write: if false;
      }

      match /messages/{msgId} {
        allow read: if hasTeamClaim(teamId)
          && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isTrainer(teamId));
        allow create: if hasTeamClaim(teamId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'body', 'createdAt', 'read']);
        allow update: if hasTeamClaim(teamId)
          && resource.data.toUid == request.auth.uid
          && onlyChanged(['read']);
        allow delete: if false;
      }
    }

    // ─── Coleção raiz: trainings (prescrição de treinos) ─────────────────
    match /trainings/{trainingId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.trainerId;

      // Trainer pode editar e excluir os seus treinos.
      allow update, delete: if signedIn()
        && request.auth.uid == resource.data.trainerId;
    }

    // ─── Coleção raiz: trainingLogs (registros de conclusão de treino) ───
    match /trainingLogs/{logId} {
      // Ambos (trainer e aluno) podem ler.
      allow read: if signedIn()
        && (request.auth.uid == resource.data.trainerId
            || request.auth.uid == resource.data.studentId);

      // Aluno cria o log ao marcar o treino como concluído.
      // Deve entrar com completedByStudent = true e confirmedByTrainer = false.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.completedByStudent == true
        && request.resource.data.confirmedByTrainer == false;

      // Trainer pode confirmar (alterar confirmedByTrainer, confirmedAt).
      // Aluno pode alterar apenas seus campos (studentNotes), nunca a confirmação.
      allow update: if signedIn()
        && (
          request.auth.uid == resource.data.trainerId
          || (
            request.auth.uid == resource.data.studentId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedByTrainer', 'confirmedAt'])
          )
        );

      allow delete: if false;
    }
  }
}
