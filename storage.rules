rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // No plano Spark (sem Cloud Functions definindo custom claims), o id do
    // time é o próprio uid do treinador dono — definido no onboarding.
    // Por isso a posse é verificada pelo uid, e não por claims de token.
    function isTeamOwner(teamId) {
      return signedIn() && request.auth.uid == teamId;
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /teams/{teamId}/branding/{fileName} {
      allow read: if true;
      allow write: if isTeamOwner(teamId) && validImage();
    }

    match /teams/{teamId}/profiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == uid
        && validImage();
    }
  }
}
